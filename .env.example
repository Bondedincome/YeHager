# =====================================================================
#  YeHagere storefront (Next.js) — environment variables
#  Copy to .env and fill in. This is the only variable the storefront needs;
#  all secrets (database, Chapa, login) live in backend/.env.
# =====================================================================

# Address of the NestJS API, including /api/v1.
# It is baked in at build time, so rebuild (npm run build) after changing it.
#   Local:       http://localhost:3000/api/v1
#   Production:  https://api.yourdomain.com/api/v1
# If left empty, the site guesses: localhost:3000 locally, api.<your domain> online.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
