# =====================================================================
#  YeHagere API (NestJS) — environment variables
#  Copy to .env and fill in. Never commit .env. Restart the API after changes.
#  Required values are marked [required]. The API will not start without them.
# =====================================================================

# --- App -------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Port the API listens on. Routes live under /api/v1.
PORT=3000
# [required] Address of the storefront. Used for CORS and for sending customers
# back after payment. Production example: https://yehagere.com
FRONTEND_URL=http://localhost:3001

# --- Database (PostgreSQL) ---------------------------------------------
# [required] all five
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=yehagere

# --- Login tokens ------------------------------------------------------
# [required] Long random string, at least 32 characters. Changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login lasts, e.g. 7d, 12h
JWT_EXPIRES_IN=7d

# --- First admin account (optional) ------------------------------------
# Only used the very first time the API starts with an empty database.
# If left empty, a one-time password is generated and printed in the API log.
ADMIN_BOOTSTRAP_PASSWORD=

# --- Chapa payments ----------------------------------------------------
# [required] Secret key from dashboard.chapa.co → Settings → API.
#   Test mode: CHASECK_TEST-...    Live mode: CHASECK-...
CHAPA_SECRET_KEY=
# Public address of this API's payment callback. Chapa calls it after each
# payment. It must be reachable from the internet in production:
#   https://api.yourdomain.com/api/v1/orders/chapa/callback
# (Locally Chapa can't reach it; payments are still confirmed when the
#  customer returns to the cart page.)
CHAPA_CALLBACK_URL=http://localhost:3000/api/v1/orders/chapa/callback
# Optional. In the Chapa dashboard → Webhooks, set the webhook URL to
#   https://api.yourdomain.com/api/v1/orders/chapa/webhook
# and paste the same "secret hash" here so webhook calls are signature-checked.
CHAPA_WEBHOOK_SECRET=
