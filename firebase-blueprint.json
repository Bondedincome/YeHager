{
  "entities": {
    "products": {
      "title": "Products",
      "description": "Store inventory, pricing, images, categories, and stock",
      "type": "collection",
      "properties": {
        "title": { "type": "string", "description": "Product display title" },
        "name": { "type": "string", "description": "Product name" },
        "subtitle": { "type": "string", "description": "Short subtitle" },
        "description": { "type": "string", "description": "Full garment description" },
        "price": { "type": "number", "description": "Price in USD" },
        "priceETB": { "type": "number", "description": "Price in Ethiopian Birr" },
        "formattedPriceETB": { "type": "string", "description": "Formatted price string e.g. Br26,100.00 ETB" },
        "imageUrl": { "type": "string", "description": "Primary high-res cover image URL" },
        "galleryImages": { "type": "array", "description": "Multi-angle photo URLs" },
        "category": { "type": "string", "description": "Garment category (sets, denim, fall, knitwear, outerwear, shoes)" },
        "isNew": { "type": "boolean", "description": "Whether product has New badge" },
        "tag": { "type": "string", "description": "Badge tag text" },
        "colors": { "type": "array", "description": "List of color variants {name, hex}" },
        "sizes": { "type": "array", "description": "Available garment sizes" },
        "stock": { "type": "number", "description": "Available inventory units" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "operations": {
        "read": "Allow public read access for storefront browsing",
        "create": "Allow admin management",
        "update": "Allow admin management",
        "delete": "Allow admin management"
      }
    },
    "orders": {
      "title": "Orders",
      "description": "Customer checkout orders and fulfillment status",
      "type": "collection",
      "properties": {
        "orderNumber": { "type": "string", "description": "Generated tracking code e.g. YH-102938" },
        "customerEmail": { "type": "string", "description": "Customer email" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "items": { "type": "array", "description": "Array of purchased line items" },
        "totalUSD": { "type": "number", "description": "Order total in USD" },
        "totalETB": { "type": "number", "description": "Order total in ETB" },
        "status": { "type": "string", "description": "Order state: confirmed, preparing, shipped, delivered" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "operations": {
        "read": "Allow public read of own orders or admin view",
        "create": "Allow checkout order creation",
        "update": "Allow admin order status updates",
        "delete": "Allow admin order deletion"
      }
    },
    "inquiries": {
      "title": "Contact Inquiries",
      "description": "Customer concierge questions, sizing help, and styling inquiries",
      "type": "collection",
      "properties": {
        "name": { "type": "string", "description": "Client full name" },
        "email": { "type": "string", "description": "Client email" },
        "subject": { "type": "string", "description": "Inquiry topic" },
        "message": { "type": "string", "description": "Message content" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "operations": {
        "read": "Allow admin view",
        "create": "Allow client submission",
        "update": "Allow admin notes",
        "delete": "Allow admin cleanup"
      }
    },
    "categories": {
      "title": "Product Categories",
      "description": "Atelier collection categories and descriptions",
      "type": "collection",
      "properties": {
        "id": { "type": "string", "description": "Category slug identifier e.g. sets, fall, kemis" },
        "name": { "type": "string", "description": "Display name of category" },
        "description": { "type": "string", "description": "Optional category description" },
        "isDefault": { "type": "boolean", "description": "Whether built-in category" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "operations": {
        "read": "Allow public read of catalog categories",
        "create": "Allow admin creation of categories",
        "update": "Allow admin update of categories",
        "delete": "Allow admin deletion of categories"
      }
    },
    "users": {
      "title": "Patrons and Staff",
      "description": "Registered patron accounts and atelier administrative staff",
      "type": "collection",
      "properties": {
        "name": { "type": "string", "description": "Full name of patron or staff member" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "description": "User role: admin, customer, or vip" },
        "status": { "type": "string", "description": "Account status: active or suspended" },
        "memberSince": { "type": "string", "description": "Membership registration date string" },
        "totalOrders": { "type": "number", "description": "Lifetime order count" },
        "totalSpentUSD": { "type": "number", "description": "Lifetime spending total" },
        "phone": { "type": "string", "description": "Contact telephone number" },
        "shippingAddress": { "type": "string", "description": "Saved shipping address" },
        "passwordHash": { "type": "string", "description": "Salted PBKDF2 hash" },
        "passwordSalt": { "type": "string", "description": "Cryptographic salt" }
      },
      "operations": {
        "read": "Restricted to authenticated owner or administrator",
        "create": "Allowed upon patron registration or by administrator",
        "update": "Allowed by owner for profile or by administrator for roles",
        "delete": "Restricted to administrator"
      }
    }
  }
}
