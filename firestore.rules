rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: public read for shop catalog, public write for instant local administration
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: allow customer creation, public order lookups
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Contact Inquiries: allow concierge form submission
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Categories: public catalog browsing, administrative management
    match /categories/{categoryId} {
      allow read, write: if true;
    }
  }
}
